# کپی کن به .env و مقداردهی کن — .env هرگز نباید commit بشه
PORT=4000
NODE_ENV=development

# مسیر فایل دیتابیس SQLite (نسبت به پوشه backend)
DATABASE_URL="file:./dev.db"

# رمز امضای JWT - یک رشته‌ی تصادفی و بلند بذار (مثلا با: openssl rand -hex 32)
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# کلید BrsApi برای قیمت صندوق‌های طلا (از brsapi.ir بگیر)
BRSAPI_KEY=""

# هر چند دقیقه یک‌بار قیمت‌ها در بک‌اند رفرش بشن (کش داخلی)
PRICE_REFRESH_MINUTES=15

# آدرس‌هایی که مجازند به API درخواست بزنند (برای CORS) - با کاما جدا کن
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
