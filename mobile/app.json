{
  "expo": {
    "name": "دارایار",
    "slug": "sekeh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sekeh",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.sekeh.app"
    },
    "android": {
      "package": "ir.sekeh.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20b848fd-7d14-43c4-a740-dfe4bcf703a5"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "20b848fd-7d14-43c4-a740-dfe4bcf703a5"
      }
    }
  }
}
