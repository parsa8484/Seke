# کپی کن به .env.local یا .env و مقداردهی کن.
# در حالت توسعه (تست با Expo Go روی گوشی واقعی) باید IP شبکه‌ی محلی
# کامپیوترت رو بذاری، نه localhost - چون گوشی یک دستگاه جداست.
# با دستور `ipconfig` (ویندوز) آی‌پی Wi-Fi رو پیدا کن.
EXPO_PUBLIC_API_URL=http://192.168.2.17:4000

# بعد از دیپلوی بک‌اند روی VPS، این مقدار رو به آدرس واقعی سرور تغییر بده، مثلا:
# EXPO_PUBLIC_API_URL=https://api.sekeh.ir
