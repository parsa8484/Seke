// Prisma schema — دیتابیس SQLite برای پروژه‌ی دارایی (سکه/طلا/صندوق)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// کاربران سایت/اپ
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // نام کاربری اختیاری — کاربر می‌تونه با ایمیل یا با این وارد بشه.
  // برای حساب‌های قدیمی (قبل از این قابلیت) خالیه.
  username     String?  @unique
  passwordHash String
  displayName  String?
  role         String   @default("user") // "user" | "admin"
  isActive     Boolean  @default(true) // غیرفعال‌شده توسط ادمین نمی‌تونه لاگین کنه
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings    Holding[]
  loginEvents LoginEvent[]
  priceAlerts PriceAlert[]
  pushTokens  PushToken[]

  @@map("users")
}

// تاریخچه‌ی ورود — هم موفق هم ناموفق، تا کاربر تلاش‌های مشکوک رو ببینه
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean  @default(true)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_events")
}

// کاتالوگ دارایی‌های قابل‌ردیابی: سکه، صندوق طلا/نقره، دستی و ...
// نگه‌داشتن این به‌صورت جدول (نه enum سخت) باعث می‌شه بعداً نقره و آیتم‌های
// جدید رو بدون migration ساختاری اضافه کنیم — فقط یک ردیف جدید insert می‌شه.
model Asset {
  id            String    @id @default(cuid())
  key           String    @unique // مثل "coin_emami" ، "fund_kahroba" ، "manual_tala"
  category      String // "coin" | "fund" | "silver_fund" | "manual"
  label         String // نمایش فارسی: "سکه امامی (تمام)"
  unit          String    @default("عدد") // عدد | گرم | واحد
  sourceType    String // "tgju" | "manual"  ("brsapi" منسوخ شده - از کار افتاد)
  sourceRef     String? // نماد در ajax.json تی‌جی‌یو، مثل "retail_sekee" یا "ime_fund_kahroba"
  // واحد عدد خامی که منبع می‌ده: "toman" (ریالی، تقسیم بر ۱۰) | "usd" | "point".
  // خالی یعنی از کاتالوگ نماد حدس زده بشه (tgjuCatalog.unitForSymbol).
  priceUnit     String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  currentPrice  Float? // آخرین قیمت کش‌شده (تومان)
  priceUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  holdings      Holding[]
  priceHistory  PriceHistory[]
  priceAlerts   PriceAlert[]

  @@map("assets")
}

// تعداد/مقداری که هر کاربر از هر دارایی داره
model Holding {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  quantity  Float    @default(0)
  // میانگین قیمت خرید هر واحد به تومان. null یعنی کاربر ثبت نکرده و
  // سود/زیان براش محاسبه نمی‌شه (صفر گذاشتن یعنی «رایگان گرفتم» که غلطه).
  avgBuyPrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@map("holdings")
}

// تاریخچه‌ی قیمت‌ها (برای نمودار روند در آینده)
model PriceHistory {
  id        String   @id @default(cuid())
  assetId   String
  price     Float
  recordedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, recordedAt])
  @@map("price_history")
}

// هشدار قیمت: «وقتی سکه به X رسید خبرم کن»
model PriceAlert {
  id        String    @id @default(cuid())
  userId    String
  assetId   String
  // "above" یعنی وقتی قیمت >= هدف شد، "below" یعنی وقتی <= هدف شد
  direction String    @default("above")
  // قیمت هدف به تومان
  targetPrice Float
  isActive  Boolean   @default(true)
  // بعد از شلیک، غیرفعال می‌شه تا هر بار رفرش دوباره نوتیف نفرسته
  triggeredAt DateTime?
  triggeredPrice Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assetId, isActive])
  @@map("price_alerts")
}

// توکن پوش‌نوتیفیکیشن Expo هر دستگاه. یک کاربر می‌تونه چند دستگاه داشته باشه.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String? // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
